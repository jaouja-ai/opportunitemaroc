# Copie ce fichier en ".env" puis remplis ce dont tu as besoin.
# --- IA (optionnel : sans clé, le CV est adapté par règles simples) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Exemples compatibles : Groq -> https://api.groq.com/openai/v1 | xAI -> https://api.x.ai/v1
# --- Base de données (SQLite par défaut ; PostgreSQL : postgresql+psycopg2://user:pass@host/db) ---
# DATABASE_URL=
# --- Adresses (utile seulement en déploiement) ---
# API_URL=http://localhost:8000
# PUBLIC_API_URL=http://localhost:8000
